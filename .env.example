# Zoho Attachment Bridge — credentials
#
# Copy to .env and fill in. Never commit the filled file.
# See docs/SELF_CLIENT_SETUP.md for how to obtain these values.

# --- Required ---------------------------------------------------------------

# Self Client ID from the Zoho API Console
ZOHO_BRIDGE_CLIENT_ID=

# Self Client secret
ZOHO_BRIDGE_CLIENT_SECRET=

# Long-lived refresh token. Treat as a password.
ZOHO_BRIDGE_REFRESH_TOKEN=

# Data center: eu | com | in | com.au | jp | ca | sa | com.cn
ZOHO_BRIDGE_DC=eu

# --- Optional convenience defaults -------------------------------------------
# These can also be passed per call. Set them only if you work against a
# single organization or portal most of the time.

# ZOHO_BRIDGE_BOOKS_ORG_ID=
# ZOHO_BRIDGE_PROJECTS_PORTAL_ID=

# Target-specific maximum upload sizes in bytes. Defaults:
# expense-receipt 7 MB, bill-attachment 5 MB, CRM record-attachment 20 MB,
# WorkDrive file upload/new version 250 MB.
# ZOHO_BRIDGE_MAX_BYTES_EXPENSE_RECEIPT=7340032
# ZOHO_BRIDGE_MAX_BYTES_BILL_ATTACHMENT=5242880
# ZOHO_BRIDGE_MAX_BYTES_RECORD_ATTACHMENT=20971520
# ZOHO_BRIDGE_MAX_BYTES_FILE_UPLOAD=262144000
# ZOHO_BRIDGE_MAX_BYTES_NEW_VERSION=262144000

# --- Additional profiles -----------------------------------------------------
# For multiple Zoho organizations, prefix each profile and select it with
# --profile <name>. Example for --profile acme:
#
# ZOHO_BRIDGE_ACME_CLIENT_ID=
# ZOHO_BRIDGE_ACME_CLIENT_SECRET=
# ZOHO_BRIDGE_ACME_REFRESH_TOKEN=
# ZOHO_BRIDGE_ACME_DC=com
